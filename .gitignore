/target
**/node_modules
/packages/*/dist
/apps/*/dist
# apps/desktop/dist n'est pas un produit de build : c'est la page locale de démarrage de la
# coquille (frontendDist de Tauri), écrite à la main et versionnée.
!/apps/desktop/dist
/packages/protocol/src/generated/*.ts
!/packages/protocol/src/generated/.gitkeep
*.log
.DS_Store
/data
.env

/packages/ui/screenshots

# Coquille de bureau (workspace Cargo à part) : build, schémas et permissions générés par tauri-build.
/apps/desktop/src-tauri/target
/apps/desktop/src-tauri/gen
/apps/desktop/src-tauri/permissions/autogenerated
/apps/desktop/tauri.sign.conf.json
/apps/desktop/tauri.noupdater.conf.json

# Worktrees temporaires des agents (outillage, jamais du contenu du projet)
/.claude/worktrees/

# Python (scripts de la CI)
__pycache__/
*.pyc
