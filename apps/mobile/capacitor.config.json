{
  "appId": "io.github.dultra123.corde",
  "appName": "Corde",
  "webDir": "www",
  "backgroundColor": "#0b0e12",
  "loggingBehavior": "debug",
  "server": {
    "androidScheme": "http"
  },
  "ios": {
    "scheme": "App",
    "backgroundColor": "#0b0e12",
    "contentInset": "never",
    "zoomEnabled": false,
    "allowsLinkPreview": false,
    "preferredContentMode": "mobile",
    "handleApplicationNotifications": true,
    "limitsNavigationsToAppBoundDomains": false
  },
  "android": {
    "backgroundColor": "#0b0e12",
    "allowMixedContent": false
  },
  "plugins": {
    "SystemBars": {
      "style": "DARK",
      "hidden": false,
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover"
    },
    "LocalNotifications": {
      "presentationOptions": ["list", "sound"],
      "smallIcon": "ic_stat_corde",
      "iconColor": "#ffb454"
    },
    "Keyboard": {
      "resize": "native",
      "style": "DARK"
    }
  }
}
